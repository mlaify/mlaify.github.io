{
    // mlaify.io — Hugo + Pagefind, served as Workers static assets.
    //
    // There is deliberately no `main` and no Worker script. With `assets` and no
    // `main`, requests are served entirely by Cloudflare's asset worker: no
    // Worker invocation, no per-request cost, nothing to keep warm. Add `main`
    // only if this site ever needs server-side logic.
    //
    // Build and deploy are driven by Workers Builds (Cloudflare clones the repo
    // and runs the build itself) — see README.md. There is no GitHub Actions
    // deploy any more, and no rsync.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mlaify-io",
    "compatibility_date": "2026-07-28",

    "assets": {
        "directory": "./public",

        // Hugo emits public/<path>/index.html, so /writing must redirect to
        // /writing/. This reproduces what GitHub Pages did implicitly and what
        // LiteSpeed's DirectorySlash did on InterServer. Verified: /sub returns
        // 307 -> /sub/.
        "html_handling": "auto-trailing-slash",

        // Hugo builds public/404.html. This serves it with a real 404 status.
        // Must NOT be "single-page-application" — that would return 200 for
        // every missing path and let soft-404s into the index.
        "not_found_handling": "404-page"
    },

    // Apex custom domains only. fhrp.org, matthewd.xyz, mldavis.me, and
    // cannotfindme.com serve the same site directly (not redirects) because
    // some services refuse to follow them; canonical URLs still point at
    // mlaify.io. They must be listed here — `wrangler deploy` replaces any
    // domains attached in the dashboard.
    // `www` is intentionally absent: it must keep 301-ing to the apex, which is
    // a Cloudflare Redirect Rule, not a second custom domain.
    "routes": [
        {
            "pattern": "mlaify.io",
            "custom_domain": true
        },
        {
            "pattern": "fhrp.org",
            "custom_domain": true
        },
        {
            "pattern": "matthewd.xyz",
            "custom_domain": true
        },
        {
            "pattern": "mldavis.me",
            "custom_domain": true
        },
        {
            "pattern": "cannotfindme.com",
            "custom_domain": true
        }
    ],

    // No <name>.workers.dev hostname for production — the site is only reachable
    // at its custom domain, so there is no unbranded duplicate for crawlers to
    // find. Preview URLs are off too: non-production branches still build and
    // upload a version, but it gets no public workers.dev URL.
    "workers_dev": false,
    "preview_urls": false,

    "observability": {
        "enabled": true
    }
}
