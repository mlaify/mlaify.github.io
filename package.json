{
  "name": "mlaify.github.io",
  "version": "0.2.0",
  "description": "mlaify product hub built with Hugo and a custom theme.",
  "author": "mlaify",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlaify/mlaify.github.io.git"
  },
  "scripts": {
    "create": "hugo new",
    "dev": "hugo server --disableFastRender --noHTTPCache",
    "dev:full": "npm run build && npx serve public -l 4173 --no-port-switching",
    "format": "prettier **/** -w -c",
    "build": "hugo --minify --gc && pagefind --site public",
    "build:hugo": "hugo --minify --gc",
    "build:search": "pagefind --site public",
    "preview": "vite preview --outDir public"
  },
  "dependencies": {
    "@tabler/icons": "^3.36.1",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "pagefind": "^1.4.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
