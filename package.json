{
  "name": "mlaify.github.io",
  "version": "0.3.0",
  "description": "mlaify.io — personal site, writing, and projects.",
  "author": "M D <mlaify@mlaify.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlaify/mlaify.github.io.git"
  },
  "scripts": {
    "create": "hugo new",
    "dev": "hugo server --disableFastRender --noHTTPCache",
    "build": "hugo --minify --gc && pagefind --site public",
    "build:cf": "npm ci && hugo --gc --minify && npx pagefind --site public && bash scripts/check-build.sh",
    "build:hugo": "hugo --minify --gc",
    "build:search": "pagefind --site public",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "format": "prettier **/** -w -c"
  },
  "dependencies": {
    "@tabler/icons": "^3.36.1",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "pagefind": "^1.4.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}